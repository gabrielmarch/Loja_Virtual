<Window x:Class="Loja_Virtual.view.Cadastro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Loja Virtual - Cadastro"
        Height="750"
        Width="1000"
        MinHeight="550"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>

        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
            <Setter Property="BorderBrush" Value="#D5D9E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CampoSenha" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
            <Setter Property="BorderBrush" Value="#D5D9E2"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="BotaoPrincipal" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="170"/>
            <Setter Property="Background" Value="#3157A4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Border Width="760"
                Height="620"
                Background="White"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#E0E4EB"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="3"
                                  Opacity="0.12"/>
            </Border.Effect>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Área de boas-vindas -->
                <Border Grid.Column="0"
                        Background="#F0F3F9"
                        CornerRadius="12,0,0,12">

                    <StackPanel VerticalAlignment="Center"
                                Margin="25">

                        <TextBlock Text="Seja Bem-Vindo a UVVirtual!"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#263B60"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,25"/>

                        <TextBlock Text="Acesse sua conta agora"
                                   FontSize="13"
                                   Foreground="#555F70"
                                   Margin="0,0,0,30"/>

                        <Button Content="ENTRAR"
                                Click="BtnEntrar_Click"
                                Style="{StaticResource BotaoPrincipal}"
                                Width="140"
                                Height="38"/>

                    </StackPanel>

                </Border>

                <!-- FORMULÁRIO DE CADASTRO -->
                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="10">

                    <StackPanel Width="310"
                                HorizontalAlignment="Center"
                                Margin="0,15">

                        <TextBlock Text="Crie sua conta"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#263B60"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,18"/>



                        <!-- NOME -->
                        <TextBlock Text="Nome completo ou nome da empresa"
                                   Foreground="#555F70"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="txtNome"
                                 Style="{StaticResource CampoTexto}"/>

                        <!-- EMAIL -->
                        <TextBlock Text="E-mail"
                                   Foreground="#555F70"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="txtEmail"
                                 Style="{StaticResource CampoTexto}"/>

                        <!-- CPF OU CNPJ -->
                        <TextBlock Text="CPF ou CNPJ"
                                   Foreground="#555F70"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="txtCpfCnpj"
                                 Style="{StaticResource CampoTexto}"
                                 MaxLength="18"
                                 TextChanged="txtCpfCnpj_TextChanged"/>

                        <!-- CAMPOS PESSOA FÍSICA -->
                        <StackPanel x:Name="CamposPessoaFisica"
                                    Visibility="Collapsed">

                            <TextBlock Text="Data de nascimento"
                                       Foreground="#555F70"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>      

                            <DatePicker x:Name="dpNascimento"
                                        Height="40"
                                        Margin="0,5,0,12"/>

                        </StackPanel>

                        <!-- CAMPOS PESSOA JURÍDICA -->
                        <StackPanel x:Name="CamposPessoaJuridica"
                                    Visibility="Collapsed">

                            <TextBlock Text="Razão social"
                                       Foreground="#555F70"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="txtRazaoSocial"
                                     Style="{StaticResource CampoTexto}"/>

                            <TextBlock Text="Nome fantasia (opcional)"
                                       Foreground="#555F70"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="txtNomeFantasia"
                                     Style="{StaticResource CampoTexto}"/>

                        </StackPanel>

                        <!-- TELEFONE -->
                        <TextBlock Text="Telefone"
                                   Foreground="#555F70"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="txtTelefone"
                                 Style="{StaticResource CampoTexto}"/>

                        <!-- ENDEREÇO -->
                        <TextBlock Text="Endereço"
                                   Foreground="#555F70"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="txtEndereco"
                                 Style="{StaticResource CampoTexto}"/>

                        <!-- SENHA -->
                        <TextBlock Text="Senha (mínimo de 8 caracteres)"
                                   Foreground="#555F70"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>

                        <PasswordBox x:Name="txtSenha"
                                     Style="{StaticResource CampoSenha}"/>

                        <!-- CONFIRMAR SENHA -->
                        <TextBlock Text="Confirmar senha"
                                   Foreground="#555F70"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>

                        <PasswordBox x:Name="txtConfirmarSenha"
                                     Style="{StaticResource CampoSenha}"/>



                        <Button x:Name="BtnCadastrar"
                                Content="CADASTRAR"
                                Click="BtnCadastrar_Click"
                                Style="{StaticResource BotaoPrincipal}"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0"/>

                    </StackPanel>
                </ScrollViewer>


            </Grid>

        </Border>

    </Grid>

</Window>
