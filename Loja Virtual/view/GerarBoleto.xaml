<Window
        x:Class="Loja_Virtual.view.GerarBoleto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Gerar Boleto" Height="600" Width="900"
        Background="#F0F0F0">

    <Grid Background="Gainsboro">
        <Grid.RowDefinitions>
            <!-- Barra superior estilo navegador -->
            <RowDefinition Height="Auto"/>
            <!-- Área principal de conteúdo -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho (Barra Superior / Menu) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="☰" FontSize="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0"/>
            </StackPanel>
        </Border>
        <Border BorderThickness="1" Margin="115,50,115,100" Grid.Row="1" Background="#FFFFFFFF" CornerRadius="8">
            <StackPanel Width="300" Height="300" HorizontalAlignment="Center" >
                <TextBlock  Text="Gerar Boleto" FontSize="16" FontWeight="Bold" 
                        HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Valor: " FontWeight="Bold"/>
                    <TextBlock x:Name="TxtValor" Text="R$ 123,45"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Vencimento: " FontWeight="Bold"/>
                    <TextBlock x:Name="TxtVencimento" Text="DD/MM/AAAA"/>
                </StackPanel>

                <TextBlock Text="Código de Barras:" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtCodigoBarras" 
                                   Text="12345.67890 12345.678901 2 12345678901234" 
                                   TextWrapping="Wrap" Foreground="#4B5563" FontSize="12"/>
                <Button Content="Copiar Código" Background="#10B981" Foreground="White" 
                            Height="38" FontWeight="Bold" Margin="0,25,0,10" 
                            Cursor="Hand" BorderThickness="0"/>
                <Button Content="Baixar Boleto" Background="#3B82F6" Foreground="White" 
                    Height="38" FontWeight="Bold" 
                    Cursor="Hand" BorderThickness="0"/>



            </StackPanel>
        </Border>



    </Grid>
</Window>