<Window x:Class="Loja_Virtual.view.GerarBoleto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:components="clr-namespace:Loja_Virtual.components"
        Title="Gerar Boleto"
        Height="750"
        Width="1250"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>

        <!-- BOTÕES DA BARRA SUPERIOR -->
        <Style x:Key="BotaoSuperior" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#344563"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#E8EEF9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÃO PRINCIPAL -->
        <Style x:Key="BotaoPrincipal" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#3157A4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#274A90"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#203D77"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÃO SECUNDÁRIO -->
        <Style x:Key="BotaoSecundario"
               TargetType="Button"
               BasedOn="{StaticResource BotaoPrincipal}">

            <Setter Property="Background" Value="#E8EEF9"/>
            <Setter Property="Foreground" Value="#3157A4"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#DCE5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ESTRUTURA PRINCIPAL -->
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaMenu" Width="165"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL COMPARTILHADO -->
        <components:MenuLateral x:Name="BarraLateral"
                                Grid.Column="0"/>

        <!-- ÁREA PRINCIPAL -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================================= -->
            <!-- BARRA SUPERIOR -->
            <!-- ================================= -->

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E0E4EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="15,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- BOTÃO HAMBÚRGUER -->
                    <Button x:Name="buttonMenu"
                            Grid.Column="0"
                            Style="{StaticResource BotaoSuperior}"
                            HorizontalAlignment="Left"
                            Click="buttonMenu_Click">

                        <materialDesign:PackIcon Kind="Menu"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#344563"/>
                    </Button>

                    <!-- CONFIGURAÇÕES E NOTIFICAÇÕES -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Style="{StaticResource BotaoSuperior}">

                            <materialDesign:PackIcon Kind="CogOutline"
                                                     Width="23"
                                                     Height="23"
                                                     Foreground="#344563"/>
                        </Button>

                        <Button Style="{StaticResource BotaoSuperior}">

                            <materialDesign:PackIcon Kind="BellOutline"
                                                     Width="23"
                                                     Height="23"
                                                     Foreground="#344563"/>
                        </Button>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- ================================= -->
            <!-- CONTEÚDO DO BOLETO -->
            <!-- ================================= -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid Margin="25"
                      MinHeight="550">

                    <!-- CARTÃO CENTRAL -->
                    <Border Width="550"
                            MaxWidth="550"
                            Background="White"
                            BorderBrush="#E0E4EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18"
                                              ShadowDepth="2"
                                              Opacity="0.10"/>
                        </Border.Effect>

                        <StackPanel>

                            <!-- ÍCONE DO BOLETO -->
                            <Border Width="60"
                                    Height="60"
                                    Background="#E8EEF9"
                                    CornerRadius="12"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,18">

                                <materialDesign:PackIcon
                                    Kind="Barcode"
                                    Width="32"
                                    Height="32"
                                    Foreground="#3157A4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <!-- TÍTULO -->
                            <TextBlock Text="Gerar Boleto"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#263B60"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Confira os dados do boleto para realizar o pagamento."
                                       FontSize="13"
                                       Foreground="#8993A5"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,30"/>

                            <!-- INFORMAÇÕES -->
                            <Border Background="#F8FAFC"
                                    BorderBrush="#E0E4EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="22"
                                    Margin="0,0,0,25">

                                <StackPanel>

                                    <!-- VALOR -->
                                    <Grid Margin="0,0,0,20">

                                        <TextBlock Text="Valor"
                                                   FontSize="14"
                                                   Foreground="#555F70"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock x:Name="TxtValor"
                                                   Text="R$ 123,45"
                                                   FontSize="19"
                                                   FontWeight="Bold"
                                                   Foreground="#3157A4"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- VENCIMENTO -->
                                    <Grid Margin="0,0,0,20">

                                        <TextBlock Text="Vencimento"
                                                   FontSize="14"
                                                   Foreground="#555F70"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock x:Name="TxtVencimento"
                                                   Text="DD/MM/AAAA"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#263B60"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- SEPARADOR -->
                                    <Border Height="1"
                                            Background="#E0E4EB"
                                            Margin="0,0,0,20"/>

                                    <!-- CÓDIGO -->
                                    <TextBlock Text="Linha digitável do boleto"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#263B60"
                                               Margin="0,0,0,10"/>

                                    <Border Background="White"
                                            BorderBrush="#D5D9E2"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14">

                                        <TextBlock x:Name="TxtCodigoBarras"
                                                   Text="12345.67890 12345.678901 2 12345678901234"
                                                   TextWrapping="Wrap"
                                                   Foreground="#555F70"
                                                   FontSize="14"
                                                   TextAlignment="Center"/>
                                    </Border>

                                </StackPanel>

                            </Border>

                            <!-- BOTÃO COPIAR -->
                            <Button x:Name="BtnCopiarCodigo"
                                    Style="{StaticResource BotaoSecundario}"
                                    Margin="0,0,0,12">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <materialDesign:PackIcon Kind="ContentCopy"
                                                             Width="19"
                                                             Height="19"
                                                             Margin="0,0,9,0"
                                                             VerticalAlignment="Center"/>

                                    <TextBlock Text="Copiar Código"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                            </Button>

                            <!-- BOTÃO BAIXAR -->
                            <Button x:Name="BtnBaixarBoleto"
                                    Style="{StaticResource BotaoPrincipal}">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <materialDesign:PackIcon Kind="Download"
                                                             Width="19"
                                                             Height="19"
                                                             Margin="0,0,9,0"
                                                             VerticalAlignment="Center"/>

                                    <TextBlock Text="Baixar Boleto"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                            </Button>

                        </StackPanel>

                    </Border>

                </Grid>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>
