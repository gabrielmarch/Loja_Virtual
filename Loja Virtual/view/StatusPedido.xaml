<Window x:Class="Loja_Virtual.view.StatusPedido"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Loja_Virtual.view"
        mc:Ignorable="d"
        Title="Pedido"
        Height="550"
        Width="800"
        MinHeight="500"
        MinWidth="650"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#FFEAEAEA">

        <!-- Estrutura principal da tela -->
        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CABEÇALHO -->
            <Grid Grid.Row="0" Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Botão voltar -->
                <Button Grid.Column="0"
                        Content="←"
                        Height="40"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#FF424242"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center" Margin="-10,0,0,0"/>

                <!-- Título -->
                <TextBlock Grid.Column="1"
                           Text="Meu Pedido"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FF424242"
                           VerticalAlignment="Center"
                           Margin="5,0,0,0"/>

            </Grid>

            <!-- ACOMPANHAMENTO DO PEDIDO -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#FFD0D0D0"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="25"
                    Margin="0,0,0,237" Grid.RowSpan="2">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- LINHA DO TEMPO -->
                    <Grid Grid.Row="0" Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Linhas conectando as etapas -->
                        <Rectangle x:Name="LinhaPedidoFeito"
                           Grid.Column="0"
                           Height="3"
                           Fill="#FFD0D0D0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="40,0,-40,0"/>

                        <Rectangle x:Name="LinhaPedidoEnviado"
                           Grid.Column="1"
                           Height="3"
                           Fill="#FFD0D0D0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="40,0,-40,0"/>

                        <Rectangle x:Name="LinhaSaiuEntrega"
                           Grid.Column="2"
                           Height="3"
                           Fill="#FFD0D0D0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="40,0,-40,0"/>        

                        <!-- Círculos das etapas -->
                        <Ellipse x:Name="EtapaPedidoFeito"
             Grid.Column="0"
             Width="20"
             Height="20"
             Fill="White"
             Stroke="Black"
             StrokeThickness="1"
             HorizontalAlignment="Center"/>

                        <Ellipse x:Name="EtapaPedidoEnviado"
             Grid.Column="1"
             Width="20"
             Height="20"
             Fill="White"
             Stroke="Black"
             StrokeThickness="1"
             HorizontalAlignment="Center"/>

                        <Ellipse x:Name="EtapaSaiuEntrega"
             Grid.Column="2"
             Width="20"
             Height="20"
             Fill="White"
             Stroke="Black"
             StrokeThickness="1"
             HorizontalAlignment="Center"/>

                        <Ellipse x:Name="EtapaEntregue"
             Grid.Column="3"
             Width="20"
             Height="20"
             Fill="White"
             Stroke="Black"
             StrokeThickness="1"
             HorizontalAlignment="Center"/>

                    </Grid>


                    <!-- Descrição das etapas -->
                    <Grid Grid.Row="1"
                          Margin="0,12,0,5">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Pedido Feito"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Foreground="#FF424242"/>

                        <TextBlock Grid.Column="1"
                                   Text="Pedido enviado"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Foreground="#FF424242"/>

                        <TextBlock Grid.Column="2"
                                   Text="Saiu para entrega"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Foreground="#FF424242"/>

                        <TextBlock Grid.Column="3"
                                   Text="Entregue"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Foreground="#FF424242"/>

                    </Grid>

                </Grid>

            </Border>


            <!-- INFORMAÇÕES DO PRODUTO -->
            <Border Grid.Row="2"
        Background="White"
        BorderBrush="#FFD0D0D0"
        BorderThickness="1"
        CornerRadius="8"
        Padding="15"
        VerticalAlignment="Top" Margin="0,246,0,0">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Imagem do produto -->
                    <Border Grid.Column="0"
                Width="70"
                Height="70"
                Background="#FFF5F5F5"
                BorderBrush="#FFE0E0E0"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"/>

                    <!-- Informações -->
                    <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="5,0,0,0">

                        <TextBlock Text="Produto"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#FF171717"/>

                        <TextBlock Text="Descrição do Produto"
                       FontSize="11"
                       Foreground="#FF868686"
                       Margin="0,3,0,0"/>

                        <TextBlock Text="Quantidade: 1 unidade"
                       FontSize="11"
                       Foreground="#FF686868"
                       Margin="0,5,0,0"/>

                    </StackPanel>

                    <!-- Preço -->
                    <StackPanel Grid.Column="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="10,0,5,0">

                        <TextBlock Text="Preço"
                       FontSize="11"
                       Foreground="#FF868686"
                       HorizontalAlignment="Right"/>

                        <TextBlock Text="R$ 149,90"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="#FF2E7D32"
                       Margin="0,4,0,0"
                       HorizontalAlignment="Right"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>
