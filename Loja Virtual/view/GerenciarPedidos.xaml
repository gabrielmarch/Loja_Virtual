<Window x:Class="Loja_Virtual.view.GerenciarPedidos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Gerenciar Pedidos - UVVirtual"
        Height="750"
        Width="1250"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="BotaoPrincipal"
               TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Background" Value="#3157A4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BotaoSecundario"
               TargetType="Button"
               BasedOn="{StaticResource BotaoPrincipal}">
            <Setter Property="Background" Value="#E8EEF9"/>
            <Setter Property="Foreground" Value="#3157A4"/>
        </Style>

        <Style x:Key="CartaoBranco"
               TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E0E4EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E0E4EB"
                BorderThickness="0,0,0,1">

            <Grid Margin="25,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <materialDesign:PackIcon
                        Kind="ClipboardListOutline"
                        Width="28"
                        Height="28"
                        Foreground="#3157A4"
                        Margin="0,0,12,0"/>

                    <TextBlock Text="Gerenciar Pedidos"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="#263B60"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Voltar ao Painel"
                        Style="{StaticResource BotaoSecundario}"
                        Click="VoltarPainel_Click"/>
            </Grid>
        </Border>

        <!-- CONTEÚDO -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30,25,30,35">

                <TextBlock Text="Administração de Pedidos"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#263B60"/>

                <TextBlock
                    Text="Acompanhe os pedidos e atualize suas etapas."
                    FontSize="14"
                    Foreground="#8993A5"
                    Margin="0,6,0,25"/>

                <!-- TABELA DE PEDIDOS -->
                <Border Style="{StaticResource CartaoBranco}"
                        Margin="0,0,0,20">

                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Pedidos Cadastrados"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="#263B60"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Content="Atualizar Lista"
                                    Style="{StaticResource BotaoSecundario}"
                                    Click="AtualizarLista_Click"/>
                        </Grid>

                        <DataGrid x:Name="ListaPedidos"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  Height="290"
                                  RowHeight="45"
                                  GridLinesVisibility="Horizontal"
                                  BorderBrush="#E0E4EB"
                                  SelectionChanged="ListaPedidos_SelectionChanged">

                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Header="Pedido"
                                    Binding="{Binding IdPedido}"
                                    Width="75"/>

                                <DataGridTextColumn
                                    Header="Cliente"
                                    Binding="{Binding NomeCliente}"
                                    Width="2*"/>

                                <DataGridTextColumn
                                    Header="Data"
                                    Binding="{Binding DataPedido,
                                              StringFormat=dd/MM/yyyy HH:mm}"
                                    Width="160"/>

                                <DataGridTextColumn
                                    Header="Total"
                                    Binding="{Binding Total,
                                              StringFormat={}{0:C2}}"
                                    Width="110"/>

                                <DataGridTextColumn
                                    Header="Pagamento"
                                    Binding="{Binding StatusPagamento}"
                                    Width="160"/>

                                <DataGridTextColumn
                                    Header="Etapa"
                                    Binding="{Binding EtapaFormatada}"
                                    Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ALTERAÇÃO DO PEDIDO -->
                <Border Style="{StaticResource CartaoBranco}">

                    <StackPanel>
                        <TextBlock Text="Atualizar Andamento"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#263B60"
                                   Margin="0,0,0,18"/>

                        <TextBlock x:Name="TxtPedidoSelecionado"
                                   Text="Selecione um pedido na tabela."
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#263B60"
                                   Margin="0,0,0,12"/>

                        <TextBlock x:Name="TxtPagamento"
                                   Text="Pagamento: -"
                                   FontSize="14"
                                   Foreground="#8993A5"
                                   Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtEtapaAtual"
                                   Text="Etapa atual: -"
                                   FontSize="14"
                                   Foreground="#8993A5"
                                   Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtProximaEtapa"
                                   Text="Próxima etapa: -"
                                   FontSize="14"
                                   Foreground="#3157A4"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,22"/>

                        <StackPanel Orientation="Horizontal">

                            <Button x:Name="BtnAvancar"
                                    Content="Avançar Etapa"
                                    Style="{StaticResource BotaoPrincipal}"
                                    IsEnabled="False"
                                    Click="AvancarEtapa_Click"/>

                        </StackPanel>

                        <Border Background="#E8EEF9"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,20,0,0">

                            <TextBlock
                                Text="Pedidos somente podem avançar após a confirmação do pagamento. Cada avanço é salvo no SQL Server e aparece na área do cliente."
                                FontSize="13"
                                Foreground="#344563"
                                TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
