<Window x:Class="Loja_Virtual.view.SuporteCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:components="clr-namespace:Loja_Virtual.components"
        Title="Suporte ao Cliente"
        Height="750"
        Width="1250"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>

        <!-- BOTÃO PRINCIPAL -->
        <Style x:Key="BotaoPrincipal" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Width" Value="230"/>
            <Setter Property="Background" Value="#3157A4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÃO SECUNDÁRIO -->
        <Style x:Key="BotaoSecundario"
               TargetType="Button"
               BasedOn="{StaticResource BotaoPrincipal}">
            <Setter Property="Background" Value="#E8EBF1"/>
            <Setter Property="Foreground" Value="#263B60"/>
        </Style>

        <!-- BOTÕES DA BARRA SUPERIOR -->
        <Style x:Key="BotaoSuperior" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#344563"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#E8EEF9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ESTRUTURA PRINCIPAL -->
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaMenu" Width="165"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL COMPARTILHADO -->
        <components:MenuLateral x:Name="BarraLateral"
                                Grid.Column="0"/>

        <!-- CONTEÚDO PRINCIPAL -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E0E4EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="15,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- BOTÃO HAMBÚRGUER -->
                    <Button x:Name="buttonMenu"
                            Grid.Column="0"
                            Style="{StaticResource BotaoSuperior}"
                            HorizontalAlignment="Left"
                            Click="buttonMenu_Click">

                        <materialDesign:PackIcon Kind="Menu"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#344563"/>
                    </Button>

                    <!-- CONFIGURAÇÕES E NOTIFICAÇÕES -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Style="{StaticResource BotaoSuperior}">

                            <materialDesign:PackIcon Kind="CogOutline"
                                                     Width="23"
                                                     Height="23"
                                                     Foreground="#344563"/>
                        </Button>

                        <Button Style="{StaticResource BotaoSuperior}">

                            <materialDesign:PackIcon Kind="BellOutline"
                                                     Width="23"
                                                     Height="23"
                                                     Foreground="#344563"/>
                        </Button>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- ÁREA DE SUPORTE -->
            <Grid Grid.Row="1"
                  Background="#F3F5F9">

                <Border Width="500"
                        Height="378"
                        Background="White"
                        BorderBrush="#E0E4EB"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="45"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <StackPanel VerticalAlignment="Center">

                        <!-- TÍTULO -->
                        <TextBlock Text="Suporte ao Cliente"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#263B60"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,35"/>

                        <!-- DESCRIÇÃO -->
                        <TextBlock Text="A tela de suporte ao cliente oferece opções para os usuários tirarem dúvidas, seja por meio de um chatbot ou entrando em contato com a ouvidoria."
                                   FontSize="14"
                                   Foreground="#555F70"
                                   TextWrapping="Wrap"
                                   TextAlignment="Left"
                                   HorizontalAlignment="Center"
                                   Width="285"
                                   LineHeight="21"
                                   Margin="0,0,0,30"/>

                        <!-- BOTÃO INICIAR CHAT -->
                        <Button x:Name="button_IniciarChat"
                                Style="{StaticResource BotaoPrincipal}"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,25"
                                Click="button_IniciarChat_Click">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon
                                    Kind="ChatProcessingOutline"
                                    Width="19"
                                    Height="19"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"/>

                                <TextBlock Text="Iniciar chat"
                                           VerticalAlignment="Center"/>

                            </StackPanel>
                        </Button>

                        <!-- BOTÃO ACESSAR OUVIDORIA -->
                        <Button x:Name="button_AcessarOuvidoria"
                                Style="{StaticResource BotaoSecundario}"
                                HorizontalAlignment="Center"
                                Click="button_AcessarOuvidoria_Click">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon
                                    Kind="Headset"
                                    Width="19"
                                    Height="19"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"/>

                                <TextBlock Text="Acessar ouvidoria"
                                           VerticalAlignment="Center"/>

                            </StackPanel>
                        </Button>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>
