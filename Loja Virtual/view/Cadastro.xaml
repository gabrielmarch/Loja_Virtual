<Window x:Class="Loja_Virtual.view.Cadastro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loja Virtual - Cadastro"
        Height="650"
        Width="1000"
        MinHeight="550"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>

        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
            <Setter Property="BorderBrush" Value="#D5D9E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CampoSenha" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
            <Setter Property="BorderBrush" Value="#D5D9E2"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="BotaoPrincipal" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="170"/>
            <Setter Property="Background" Value="#3157A4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Border Width="760"
                Height="470"
                Background="White"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#E0E4EB"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="3"
                                  Opacity="0.12"/>
            </Border.Effect>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Área de boas-vindas -->
                <Border Grid.Column="0"
                        Background="#F0F3F9"
                        CornerRadius="12,0,0,12">

                    <StackPanel VerticalAlignment="Center"
                                Margin="25">

                        <TextBlock Text="Seja Bem-Vindo a UVVirtual!"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#263B60"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,25"/>

                        <TextBlock Text="Acesse sua conta agora"
                                   FontSize="13"
                                   Foreground="#555F70"
                                   Margin="0,0,0,30"/>

                        <Button Content="ENTRAR"
                                Click="BtnEntrar_Click"
                                Style="{StaticResource BotaoPrincipal}"
                                Width="140"
                                Height="38"/>

                    </StackPanel>

                </Border>

                <!-- Formulário de Cadastro -->
                <StackPanel Grid.Column="1"
                            Width="310"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Crie sua conta"
                               FontSize="29"
                               FontWeight="Bold"
                               Foreground="#263B60"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBox x:Name="txtNome"
                             Style="{StaticResource CampoTexto}"
                             ToolTip="Nome completo"/>

                    <TextBox x:Name="txtEmail"
                             Style="{StaticResource CampoTexto}"
                             ToolTip="E-mail"/>

                    <TextBox x:Name="txtCpfCnpj"
                             Style="{StaticResource CampoTexto}"
                             MaxLength="18"
                             ToolTip="CPF ou CNPJ"/>

                    <PasswordBox x:Name="txtSenha"
                                 Style="{StaticResource CampoSenha}"
                                 ToolTip="Senha"/>

                    <PasswordBox x:Name="txtConfirmarSenha"
                                 Style="{StaticResource CampoSenha}"
                                 ToolTip="Confirmar senha"/>

                    <Button Content="CADASTRAR"
                            Click="BtnCadastrar_Click"
                            Style="{StaticResource BotaoPrincipal}"
                            HorizontalAlignment="Center"
                            Margin="0,5,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>
