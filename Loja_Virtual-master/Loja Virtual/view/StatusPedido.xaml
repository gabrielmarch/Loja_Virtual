<Window x:Class="Loja_Virtual.view.StatusPedido"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:components="clr-namespace:Loja_Virtual.components"
        Title="Meus Pedidos"
        Height="750"
        Width="1250"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>

        <!-- BOTÕES DO MENU LATERAL -->
        <Style x:Key="BotaoMenu" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#344563"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#E8EEF9"/>
                                <Setter Property="Foreground"
                                        Value="#3157A4"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#DCE5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÕES DA BARRA SUPERIOR -->
        <Style x:Key="BotaoSuperior" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#344563"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#E8EEF9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CARDS -->
        <Style x:Key="CartaoPedido" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E4EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <!-- TEXTOS DOS STATUS -->
        <Style x:Key="TextoStatus" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#8993A5"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaMenu" Width="165"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ====================================== -->
        <!-- MENU LATERAL -->
        <!-- ====================================== -->

        <!-- MENU LATERAL COMPARTILHADO -->
        <components:MenuLateral x:Name="BarraLateral"
                        Grid.Column="0"/>

        <!-- ====================================== -->
        <!-- CONTEÚDO PRINCIPAL -->
        <!-- ====================================== -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E0E4EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="15,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- BOTÃO HAMBÚRGUER -->
                    <Button x:Name="buttonMenu"
                            Grid.Column="0"
                            Style="{StaticResource BotaoSuperior}"
                            HorizontalAlignment="Left"
                            Click="buttonMenu_Click">

                        <materialDesign:PackIcon Kind="Menu"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#344563"/>
                    </Button>

                    <!-- CONFIGURAÇÕES E NOTIFICAÇÕES -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Style="{StaticResource BotaoSuperior}">
                            <materialDesign:PackIcon Kind="CogOutline"
                                                     Width="23"
                                                     Height="23"
                                                     Foreground="#344563"/>
                        </Button>

                        <Button Style="{StaticResource BotaoSuperior}">
                            <materialDesign:PackIcon Kind="BellOutline"
                                                     Width="23"
                                                     Height="23"
                                                     Foreground="#344563"/>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTEÚDO DA TELA -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="30,25,30,35">

                    <!-- CABEÇALHO -->
                    <StackPanel Margin="0,0,0,25">

                        <TextBlock Text="Meu Pedido"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#263B60"/>

                        <TextBlock Text="Acompanhe o andamento do seu pedido."
                                   FontSize="14"
                                   Foreground="#8993A5"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- ====================================== -->
                    <!-- ACOMPANHAMENTO DO PEDIDO -->
                    <!-- ====================================== -->

                    <Border Style="{StaticResource CartaoPedido}"
                            Margin="0,0,0,25">

                        <StackPanel>

                            <Grid Margin="0,0,0,30">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LINHA ENTRE AS ETAPAS -->
                                <Border Grid.ColumnSpan="4"
                                        Height="3"
                                        Background="#E0E4EB"
                                        Margin="65,22,65,0"
                                        VerticalAlignment="Top"
                                        Panel.ZIndex="0"/>

                                <!-- PROGRESSO ATÉ A SEGUNDA ETAPA -->
                                <Border Grid.ColumnSpan="4"
                                        Height="3"
                                        Background="#3157A4"
                                        HorizontalAlignment="Left"
                                        Width="300"
                                        MaxWidth="300"
                                        Margin="65,22,0,0"
                                        VerticalAlignment="Top"
                                        Panel.ZIndex="1"/>

                                <!-- ETAPA 1 -->
                                <StackPanel Grid.Column="0"
                                            HorizontalAlignment="Center"
                                            Panel.ZIndex="2">

                                    <Border Width="46"
                                            Height="46"
                                            CornerRadius="23"
                                            Background="#3157A4"
                                            HorizontalAlignment="Center">

                                        <materialDesign:PackIcon Kind="Check"
                                                                 Width="23"
                                                                 Height="23"
                                                                 Foreground="White"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="Pedido feito"
                                               Style="{StaticResource TextoStatus}"
                                               Foreground="#3157A4"
                                               Margin="0,12,0,0"/>
                                </StackPanel>

                                <!-- ETAPA 2 -->
                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            Panel.ZIndex="2">

                                    <Border Width="46"
                                            Height="46"
                                            CornerRadius="23"
                                            Background="#3157A4"
                                            HorizontalAlignment="Center">

                                        <materialDesign:PackIcon Kind="PackageVariant"
                                                                 Width="23"
                                                                 Height="23"
                                                                 Foreground="White"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="Pedido enviado"
                                               Style="{StaticResource TextoStatus}"
                                               Foreground="#3157A4"
                                               Margin="0,12,0,0"/>
                                </StackPanel>

                                <!-- ETAPA 3 -->
                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            Panel.ZIndex="2">

                                    <Border Width="46"
                                            Height="46"
                                            CornerRadius="23"
                                            Background="#F0F3F9"
                                            BorderBrush="#D5D9E2"
                                            BorderThickness="2"
                                            HorizontalAlignment="Center">

                                        <materialDesign:PackIcon Kind="TruckDeliveryOutline"
                                                                 Width="23"
                                                                 Height="23"
                                                                 Foreground="#8993A5"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="Saiu para entrega"
                                               Style="{StaticResource TextoStatus}"
                                               Margin="0,12,0,0"/>
                                </StackPanel>

                                <!-- ETAPA 4 -->
                                <StackPanel Grid.Column="3"
                                            HorizontalAlignment="Center"
                                            Panel.ZIndex="2">

                                    <Border Width="46"
                                            Height="46"
                                            CornerRadius="23"
                                            Background="#F0F3F9"
                                            BorderBrush="#D5D9E2"
                                            BorderThickness="2"
                                            HorizontalAlignment="Center">

                                        <materialDesign:PackIcon Kind="HomeOutline"
                                                                 Width="23"
                                                                 Height="23"
                                                                 Foreground="#8993A5"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="Entregue"
                                               Style="{StaticResource TextoStatus}"
                                               Margin="0,12,0,0"/>
                                </StackPanel>

                            </Grid>

                            <!-- RESUMO DO STATUS -->
                            <Border Background="#F0F3F9"
                                    CornerRadius="8"
                                    Padding="16">

                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="InformationOutline"
                                                             Width="22"
                                                             Height="22"
                                                             Foreground="#3157A4"
                                                             Margin="0,0,10,0"/>

                                    <TextBlock Text="Seu pedido foi enviado e está a caminho."
                                               FontSize="14"
                                               Foreground="#263B60"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                    </Border>

                    <!-- ====================================== -->
                    <!-- PRODUTOS DO PEDIDO -->
                    <!-- ====================================== -->

                    <TextBlock Text="Produtos do pedido"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#263B60"
                               Margin="0,0,0,15"/>

                    <Border Style="{StaticResource CartaoPedido}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- IMAGEM DO PRODUTO -->
                            <Border Grid.Column="0"
                                    Width="70"
                                    Height="70"
                                    Background="#F0F3F9"
                                    CornerRadius="8"
                                    HorizontalAlignment="Left">

                                <materialDesign:PackIcon Kind="PackageVariant"
                                                         Width="35"
                                                         Height="35"
                                                         Foreground="#A0A8B7"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>

                            <!-- INFORMAÇÕES DO PRODUTO -->
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Produto"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#263B60"/>

                                <TextBlock Text="Descrição do produto"
                                           FontSize="13"
                                           Foreground="#8993A5"
                                           Margin="0,5,0,0"/>

                                <TextBlock Text="Quantidade: 1 unidade"
                                           FontSize="13"
                                           Foreground="#555F70"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- PREÇO -->
                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Margin="15,0,0,0">

                                <TextBlock Text="Preço"
                                           FontSize="12"
                                           Foreground="#8993A5"
                                           HorizontalAlignment="Right"/>

                                <TextBlock Text="R$ 149,90"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="#3157A4"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>

                        </Grid>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>
