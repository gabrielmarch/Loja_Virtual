<Window x:Class="Loja_Virtual.view.MetodoPagamento"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Métodos de Pagamento" Height="600" Width="900"
        Background="#F0F0F0">

    <Grid>
        <Grid.RowDefinitions>
            
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="☰" FontSize="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0"/>
            </StackPanel>
        </Border>

        
        <Border Grid.Row="1" Background="#FFFFFF" Width="550" Padding="30" 
                CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" Height="310">

            <StackPanel HorizontalAlignment="Center">
                
                <TextBlock Text="Métodos de Pagamento" FontSize="20" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- Botões de Opções de Pagamento -->
                <StackPanel Width="280">
                    <!-- Botão Cartão de Crédito/Débito -->
                    <Button x:Name="BtnIrParaCartao" Content="Cartão de Crédito/Débito" 
                            Background="#3B82F6" Foreground="White" 
                            BorderBrush="#CCCCCC" BorderThickness="1"
                            Height="45" FontWeight="Bold" Margin="0,0,0,15" 
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnIrParaBoleto_Copiar1" Content="Boleto" 
                        Background="#3B82F6" Foreground="White" 
                        BorderBrush="#CCCCCC" BorderThickness="1"
                        Height="44" FontWeight="Bold" 
                        Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Botão Boleto -->
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>