<Window x:Class="Loja_Virtual.view.Cupons"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:Loja_Virtual.components"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Meus Cupons"
        Height="750"
        Width="1250"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>

        <Style x:Key="BotaoSuperior" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BotaoCupom" TargetType="Button">
            <Setter Property="Background" Value="#3157A4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaMenu"
                              Width="165"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL -->
        <components:MenuLateral x:Name="BarraLateral"
                                Grid.Column="0"/>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E0E4EB"
                    BorderThickness="0,0,0,1">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0">

                    <Button Style="{StaticResource BotaoSuperior}"
                            Click="buttonMenu_Click">

                        <materialDesign:PackIcon Kind="Menu"
                                                 Width="25"
                                                 Height="25"
                                                 Foreground="#344563"/>
                    </Button>

                    <TextBlock Text="Meus Cupons"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#263B60"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- CONTEÚDO -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="30,25,30,35">

                    <!-- CABEÇALHO -->
                    <TextBlock Text="Cupons de Desconto"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#263B60"/>

                    <TextBlock
                        Text="Confira os cupons disponíveis para utilizar em suas compras."
                        FontSize="14"
                        Foreground="#8993A5"
                        Margin="0,6,0,25"/>

                    <!-- AVISO -->
                    <Border Background="#E8EEF9"
                            CornerRadius="10"
                            Padding="18"
                            Margin="0,0,0,25">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Kind="InformationOutline"
                                Width="24"
                                Height="24"
                                Foreground="#3157A4"
                                Margin="0,0,12,0"/>

                            <TextBlock
                                Text="Copie o código do cupom e utilize-o no carrinho de compras."
                                Foreground="#263B60"
                                FontSize="14"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- LISTA DINÂMICA DE CUPONS -->
                    <ItemsControl x:Name="ListaCupons">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Width="310"
                                        Background="White"
                                        BorderBrush="#E0E4EB"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="22"
                                        Margin="0,0,18,18">

                                    <StackPanel>

                                        <materialDesign:PackIcon
                                            Kind="TicketPercentOutline"
                                            Width="35"
                                            Height="35"
                                            Foreground="#3157A4"
                                            Margin="0,0,0,15"/>

                                        <TextBlock
                                            Text="{Binding CodigoCupom}"
                                            FontSize="19"
                                            FontWeight="Bold"
                                            Foreground="#263B60"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,10,0,15">

                                            <TextBlock
                                                Text="{Binding Desconto, StringFormat={}{0:0.##}}"
                                                FontSize="32"
                                                FontWeight="Bold"
                                                Foreground="#3157A4"/>

                                            <TextBlock
                                                Text="% OFF"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Foreground="#3157A4"
                                                VerticalAlignment="Bottom"
                                                Margin="5,0,0,4"/>
                                        </StackPanel>

                                        <TextBlock
                                            Text="{Binding DataValidade, StringFormat='Válido até {0:dd/MM/yyyy}'}"
                                            FontSize="13"
                                            Foreground="#8993A5"
                                            Margin="0,0,0,20"/>

                                        <Button
                                            Content="Copiar código"
                                            Tag="{Binding CodigoCupom}"
                                            Style="{StaticResource BotaoCupom}"
                                            Click="CopiarCupom_Click"/>

                                    </StackPanel>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="MensagemSemCupons"
                               Text="Nenhum cupom disponível no momento."
                               FontSize="15"
                               Foreground="#8993A5"
                               Visibility="Collapsed"
                               Margin="0,15,0,20"/>

                    <Button Content="Ir para o carrinho"
                            Width="190"
                            Height="42"
                            HorizontalAlignment="Left"
                            Background="#E8EEF9"
                            Foreground="#3157A4"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="IrCarrinho_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
