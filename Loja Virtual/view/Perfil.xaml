<UserControl x:Class="Loja_Virtual.view.Perfil"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="650"
             MinWidth="800"
             MinHeight="550"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="#F3F5F9">

    <UserControl.Resources>

        <!-- Estilo dos cartões -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="BorderBrush" Value="#E0E4EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <!-- Estilo dos títulos dos campos -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8290A8"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <!-- Estilo dos valores -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#263B60"/>
        </Style>

        <!-- Botão principal -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#3157A4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Botão secundário -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#EDF2FC"/>
            <Setter Property="Foreground" Value="#3157A4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="#F3F5F9">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="24">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CABEÇALHO -->

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,22">

                    <TextBlock Text="Meu Perfil"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#263B60"/>

                    <TextBlock Text="Gerencie suas informações pessoais e sua conta."
                               FontSize="13"
                               Foreground="#8290A8"
                               Margin="0,7,0,0"/>

                </StackPanel>


                <!-- CARTÃO DE IDENTIFICAÇÃO -->

                <Border Grid.Row="1"
                        Style="{StaticResource CardStyle}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- AVATAR -->

                        <Border Width="78"
                                Height="78"
                                CornerRadius="39"
                                Background="#E5EDFC"
                                VerticalAlignment="Center">

                            <TextBlock Text="AM"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#3157A4"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <!-- DADOS DO USUÁRIO -->

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="20,0,10,0">

                            <TextBlock Text="Antônio Modenese"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#263B60"/>

                            <TextBlock Text="antonio@email.com"
                                       FontSize="13"
                                       Foreground="#8290A8"
                                       Margin="0,5,0,9"/>

                            <Border Background="#E5F6EB"
                                    CornerRadius="10"
                                    Padding="9,4"
                                    HorizontalAlignment="Left">

                                <TextBlock Text="● Conta ativa"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#26834A"/>

                            </Border>

                        </StackPanel>

                        <!-- BOTÃO EDITAR -->

                        <Button Grid.Column="2"
                                Content="Editar perfil"
                                Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Center"/>

                    </Grid>

                </Border>


                <!-- INFORMAÇÕES PESSOAIS -->

                <Border Grid.Row="2"
                        Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Informações pessoais"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#263B60"
                                   Margin="0,0,0,25"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <!-- NOME -->

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,20,24">

                                <TextBlock Text="Nome completo"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBlock Text="Antônio Modenese"
                                           Style="{StaticResource ValueStyle}"/>

                            </StackPanel>


                            <!-- EMAIL -->

                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="20,0,0,24">

                                <TextBlock Text="E-mail"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBlock Text="antonio@email.com"
                                           Style="{StaticResource ValueStyle}"/>

                            </StackPanel>


                            <!-- CPF / CNPJ -->

                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,20,24">

                                <TextBlock Text="CPF / CNPJ"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBlock Text="000.000.000-00"
                                           Style="{StaticResource ValueStyle}"/>

                            </StackPanel>


                            <!-- TELEFONE -->

                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="20,0,0,24">

                                <TextBlock Text="Telefone"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBlock Text="(00) 00000-0000"
                                           Style="{StaticResource ValueStyle}"/>

                            </StackPanel>


                            <!-- ENDEREÇO -->

                            <StackPanel Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,0,20,0">

                                <TextBlock Text="Endereço"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBlock Text="Não informado"
                                           Style="{StaticResource ValueStyle}"/>

                            </StackPanel>


                            <!-- TIPO DE CADASTRO -->

                            <StackPanel Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="20,0,0,0">

                                <TextBlock Text="Tipo de cadastro"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBlock Text="Pessoa Física"
                                           Style="{StaticResource ValueStyle}"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- SEGURANÇA E CONTA -->

                <Border Grid.Row="3"
                        Style="{StaticResource CardStyle}"
                        Margin="0">

                    <StackPanel>

                        <TextBlock Text="Segurança e conta"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#263B60"
                                   Margin="0,0,0,25"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- SENHA -->

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Senha"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBlock Text="••••••••••"
                                           Style="{StaticResource ValueStyle}"/>

                            </StackPanel>

                            <!-- DATA DE CADASTRO -->

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Data de cadastro"
                                           Style="{StaticResource LabelStyle}"/>

                                <TextBlock Text="Não informada"
                                           Style="{StaticResource ValueStyle}"/>

                            </StackPanel>

                        </Grid>

                        <Separator Margin="0,24,0,20"
                                   Background="#E0E4EB"/>

                        <Button Content="Alterar senha"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"/>

                    </StackPanel>

                </Border>

            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>
