<Window x:Class="Loja_Virtual.view.SuporteCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Suporte ao Cliente"
        Height="750"
        Width="1250"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>

        <!-- Botão principal -->
        <Style x:Key="BotaoPrincipal" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Width" Value="230"/>
            <Setter Property="Background" Value="#3157A4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão secundário -->
        <Style x:Key="BotaoSecundario" TargetType="Button"
               BasedOn="{StaticResource BotaoPrincipal}">
            <Setter Property="Background" Value="#E8EBF1"/>
            <Setter Property="Foreground" Value="#263B60"/>
        </Style>

        <!-- Botão do menu -->
        <Style x:Key="BotaoMenu" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Grid Grid.Row="0">
            <Button Style="{StaticResource BotaoMenu}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="20,0,0,0">

                <materialDesign:PackIcon Kind="Menu"
                                         Width="25"
                                         Height="25"
                                         Foreground="#263B60"/>
            </Button>
        </Grid>

        <!-- Conteúdo central -->
        <Grid Grid.Row="1">

            <Border Width="500"
                    Height="378"
                    Background="White"
                    BorderBrush="#E0E4EB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="45"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel VerticalAlignment="Center">

                    <!-- Título -->
                    <TextBlock Text="Suporte ao Cliente"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#263B60"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,35"/>

                    <!-- Descrição -->
                    <TextBlock Text="A tela de suporte ao cliente oferece opções para os usuários tirarem dúvidas, seja por meio de um chatbot ou entrando em contato com a ouvidoria."
                               FontSize="14"
                               Foreground="#555F70"
                               TextWrapping="Wrap"
                               TextAlignment="Left"
                               HorizontalAlignment="Center"
                               Width="285"
                               LineHeight="21"
                               Margin="0,0,0,30"/>

                    <!-- Botão iniciar chat -->
                    <Button x:Name="button_IniciarChat" Style="{StaticResource BotaoPrincipal}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,25" Click="button_IniciarChat_Click">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChatProcessingOutline"
                                                     Width="19"
                                                     Height="19"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"/>

                            <TextBlock Text="Iniciar chat"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                    </Button>

                    <!-- Botão ouvidoria -->
                    <Button x:Name="button_AcessarOuvidoria" Style="{StaticResource BotaoSecundario}"
                            HorizontalAlignment="Center" Click="button_AcessarOuvidoria_Click">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Headset"
                                                     Width="19"
                                                     Height="19"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"/>

                            <TextBlock Text="Acessar ouvidoria"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                    </Button>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>
