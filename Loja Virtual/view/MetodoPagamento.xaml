<Window x:Class="Loja_Virtual.view.MetodoPagamento"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:components="clr-namespace:Loja_Virtual.components"
        Title="Métodos de Pagamento"
        Height="750"
        Width="1250"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>

        <!-- BOTÕES DA BARRA SUPERIOR -->
        <Style x:Key="BotaoSuperior" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#344563"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#E8EEF9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÕES DE PAGAMENTO -->
        <Style x:Key="BotaoPagamento" TargetType="Button">
            <Setter Property="Height" Value="55"/>
            <Setter Property="Background" Value="#3157A4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="15">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#274A90"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#203D77"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ESTRUTURA PRINCIPAL -->
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaMenu" Width="165"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL COMPARTILHADO -->
        <components:MenuLateral x:Name="BarraLateral"
                                Grid.Column="0"/>

        <!-- ÁREA PRINCIPAL -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================================= -->
            <!-- BARRA SUPERIOR -->
            <!-- ================================= -->

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E0E4EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="15,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- BOTÃO HAMBÚRGUER -->
                    <Button x:Name="buttonMenu"
                            Grid.Column="0"
                            Style="{StaticResource BotaoSuperior}"
                            HorizontalAlignment="Left"
                            Click="buttonMenu_Click">

                        <materialDesign:PackIcon Kind="Menu"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#344563"/>
                    </Button>

                    <!-- CONFIGURAÇÕES E NOTIFICAÇÕES -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Style="{StaticResource BotaoSuperior}">

                            <materialDesign:PackIcon
                                Kind="CogOutline"
                                Width="23"
                                Height="23"
                                Foreground="#344563"/>
                        </Button>

                        <Button Style="{StaticResource BotaoSuperior}">

                            <materialDesign:PackIcon
                                Kind="BellOutline"
                                Width="23"
                                Height="23"
                                Foreground="#344563"/>
                        </Button>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- ================================= -->
            <!-- CONTEÚDO DE PAGAMENTO -->
            <!-- ================================= -->

            <Grid Grid.Row="1"
                  Background="#F3F5F9">

                <!-- CARTÃO CENTRAL -->
                <Border Width="500"
                        MaxWidth="500"
                        Background="White"
                        BorderBrush="#E0E4EB"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                                          ShadowDepth="2"
                                          Opacity="0.10"/>
                    </Border.Effect>

                    <StackPanel>

                        <!-- ÍCONE DE PAGAMENTO -->
                        <Border Width="60"
                                Height="60"
                                Background="#E8EEF9"
                                CornerRadius="12"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,20">

                            <materialDesign:PackIcon
                                Kind="CreditCardOutline"
                                Width="30"
                                Height="30"
                                Foreground="#3157A4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <!-- TÍTULO -->
                        <TextBlock Text="Métodos de Pagamento"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#263B60"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <!-- DESCRIÇÃO -->
                        <TextBlock Text="Escolha como deseja realizar o pagamento da sua compra."
                                   FontSize="13"
                                   Foreground="#8993A5"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,30"/>

                        <!-- VALOR TOTAL DA COMPRA -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,15,0,20">

                            <TextBlock Text="Total da compra: "
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#263B60"/>

                            <TextBlock x:Name="ValorCompraTexto"
                                       Text="R$ 0,00"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#3157A4"/>

                        </StackPanel>


                        <!-- BOTÕES -->
                        <StackPanel>

                            <!-- CARTÃO DE CRÉDITO OU DÉBITO -->
                            <Button x:Name="BtnIrParaCartao"
                                    Style="{StaticResource BotaoPagamento}"
                                    Margin="0,0,0,15"
                                    Click="BtnIrParaCartao_Click" Height="44" Width="337">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <materialDesign:PackIcon
                                        Kind="CreditCardOutline"
                                        Width="22"
                                        Height="22"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"/>

                                    <TextBlock Text="Cartão de Crédito/Débito"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                            </Button>

                            <!-- BOLETO -->
                            <Button x:Name="BtnIrParaBoleto_Copiar1"
                                    Style="{StaticResource BotaoPagamento}"
                                    Click="BtnIrParaBoleto_Click" Height="45" Width="337">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <materialDesign:PackIcon
                                        Kind="Barcode"
                                        Width="22"
                                        Height="22"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"/>

                                    <TextBlock Text="Boleto Bancário"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                            </Button>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>
