<Window x:Class="Loja_Virtual.view.Perfil"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meu Perfil"
        Height="650"
        Width="1000"
        MinHeight="550"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid Margin="40">
        <Border Background="White"
                CornerRadius="15"
                Padding="35"
                Width="550"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="Meu Perfil"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#20243A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <Border Width="90"
                        Height="90"
                        CornerRadius="50"
                        Background="#E8EAF6"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,15">
                    <TextBlock Text="&#xE77B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="40"
                               Foreground="#4556A8"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Nome do usuário"
                           FontSize="23"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#20243A"
                           x:Name="NomeUsuario"/>

                <TextBlock Text="email@exemplo.com"
                           FontSize="15"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,30"
                           x:Name="EmailUsuario"/>

                <Border Background="#F1F3FA"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Meus pedidos"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#20243A"/>

                        <TextBlock Text="0"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="#4556A8"
                                   Margin="0,8,0,0"
                                   x:Name="QuantidadePedidos"/>

                        <TextBlock Text="Pedidos realizados"
                                   FontSize="13"
                                   Foreground="Gray"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
