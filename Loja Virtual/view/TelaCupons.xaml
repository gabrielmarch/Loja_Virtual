<Window x:Class="Loja_Virtual.view.TelaCupons"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:components="clr-namespace:Loja_Virtual.components"
        Title="Cupons"
        Height="750"
        Width="1250"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>

        <!-- Botões do menu -->
        <Style x:Key="BotaoSuperior" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#344563"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#E8EEF9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cartão de cupom -->
        <Style x:Key="CartaoCupom" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE2EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="7"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="165"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL -->
        <components:MenuLateral
            x:Name="BarraLateral"
            Grid.Column="0"/>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E0E4EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="15,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="buttonMenu"
                            Grid.Column="0"
                            Style="{StaticResource BotaoSuperior}"
                            HorizontalAlignment="Left"
                            Click="buttonMenu_Click">

                        <materialDesign:PackIcon Kind="Menu"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#344563"/>
                    </Button>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Style="{StaticResource BotaoSuperior}">
                            <materialDesign:PackIcon Kind="CogOutline"
                                                     Width="23"
                                                     Height="23"
                                                     Foreground="#344563"/>
                        </Button>

                        <Button Style="{StaticResource BotaoSuperior}">
                            <materialDesign:PackIcon Kind="BellOutline"
                                                     Width="23"
                                                     Height="23"
                                                     Foreground="#344563"/>
                        </Button>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- CONTEÚDO -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="15,20,15,25">

                    <!-- TÍTULO -->
                    <TextBlock Text="Cupons"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#263B60"
                               Margin="8,5,0,5"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Confira nossos cupons e aproveite os descontos disponíveis."
                               FontSize="14"
                               Foreground="#8993A5"
                               Margin="8,0,0,20"/>

                    <!-- LISTAGEM DOS CUPONS -->
                    <ItemsControl x:Name="ListaCupons">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Style="{StaticResource CartaoCupom}">

                                    <StackPanel>

                                        <!-- ÍCONE -->
                                        <Border Height="65"
                                                Background="#EEF3FC"
                                                CornerRadius="8"
                                                Margin="0,0,0,12">

                                            <materialDesign:PackIcon
                                                Kind="TicketPercentOutline"
                                                Width="35"
                                                Height="35"
                                                Foreground="#3157A4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- CÓDIGO -->
                                        <TextBlock Text="{Binding Codigo}"
                                                   FontSize="19"
                                                   FontWeight="Bold"
                                                   Foreground="#263B60"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,8"/>

                                        <!-- DESCRIÇÃO -->
                                        <TextBlock Text="{Binding Descricao}"
                                                   FontSize="13"
                                                   Foreground="#8993A5"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12"/>

                                        <!-- DESCONTO -->
                                        <Border Background="#EAF1FF"
                                                CornerRadius="7"
                                                Padding="10"
                                                Margin="0,0,0,12">

                                            <TextBlock Text="{Binding DescontoTexto}"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="#3157A4"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- VALIDADE -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,8">

                                            <materialDesign:PackIcon
                                                Kind="CalendarOutline"
                                                Width="16"
                                                Height="16"
                                                Foreground="#8993A5"
                                                Margin="0,0,5,0"/>

                                            <TextBlock Text="{Binding ValidadeTexto}"
                                                       FontSize="12"
                                                       Foreground="#8993A5"/>
                                        </StackPanel>

                                        <!-- STATUS -->
                                        <TextBlock Text="{Binding StatusTexto}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2E8B57"
                                                   HorizontalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>
