<Window x:Class="Loja_Virtual.view.ChatSuporte"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Chatbot de Suporte"
        Height="750"
        Width="1250"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>

        <!-- Botão do menu -->
        <Style x:Key="BotaoMenu" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Mensagens do cliente -->
        <Style x:Key="MensagemCliente" TargetType="Border">
            <Setter Property="Background" Value="#DCE8FF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="MaxWidth" Value="300"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>

        <!-- Mensagens do chatbot -->
        <Style x:Key="MensagemBot" TargetType="Border">
            <Setter Property="Background" Value="#E8EBF1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="MaxWidth" Value="300"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Grid Grid.Row="0">

            <Button Style="{StaticResource BotaoMenu}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="20,0,0,0">

                <materialDesign:PackIcon Kind="Menu"
                                         Width="25"
                                         Height="25"
                                         Foreground="#263B60"/>
            </Button>

        </Grid>

        <!-- Área principal -->
        <Border Grid.Row="1"
                Margin="15,0,15,15"
                Background="White"
                BorderBrush="#E0E4EB"
                BorderThickness="1"
                CornerRadius="10"
                Padding="35">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título -->
                <TextBlock Grid.Row="0"
                           Text="Chatbot de Suporte"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#3157A4"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Conversa -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="20,0">

                        <!-- Mensagem do chatbot -->
                        <Border Style="{StaticResource MensagemBot}"
                                Margin="0,0,0,35">

                            <TextBlock Text="Olá! Como posso ajudar você hoje?"
                                       FontSize="15"
                                       Foreground="#263B60"
                                       TextWrapping="Wrap"/>

                        </Border>

                        <!-- Mensagem do cliente -->
                        <Border Style="{StaticResource MensagemCliente}"
                                Margin="0,0,0,35">

                            <TextBlock Text="Tenho uma dúvida sobre minha fatura."
                                       FontSize="15"
                                       Foreground="#263B60"
                                       TextWrapping="Wrap"/>

                        </Border>

                        <!-- Mensagem do chatbot -->
                        <Border Style="{StaticResource MensagemBot}"
                                Margin="0,0,0,35">

                            <TextBlock Text="Por favor, digite o número da sua fatura para que eu possa verificar."
                                       FontSize="15"
                                       Foreground="#263B60"
                                       TextWrapping="Wrap"/>

                        </Border>

                        <!-- Mensagem do cliente -->
                        <Border Style="{StaticResource MensagemCliente}">

                            <TextBlock Text="Minha fatura é 12345."
                                       FontSize="15"
                                       Foreground="#263B60"
                                       TextWrapping="Wrap"/>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

                <!-- Campo de envio -->
                <Grid Grid.Row="2"
                      Margin="20,20,20,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Height="42"
                             FontSize="14"
                             Padding="12,9"
                             VerticalContentAlignment="Center"
                             Background="White"
                             Foreground="#263B60"
                             BorderBrush="#D5D9E2"
                             BorderThickness="1"
                             Text="Digite sua mensagem..."
                             MaxLength="500"/>

                    <Button Grid.Column="1"
                            Height="38"
                            Margin="10,0,-11,0"
                            Background="#3157A4"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalAlignment="Center">

                        <materialDesign:PackIcon Kind="Send"
                                                 Width="19"
                                                 Height="19"
                                                 Foreground="White"/>

                    </Button>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>
