<Window x:Class="Loja_Virtual.view.ChatSuporte"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:components="clr-namespace:Loja_Virtual.components"
        Title="Chatbot de Suporte"
        Height="750"
        Width="1250"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>

        <!-- BOTÕES DA BARRA SUPERIOR -->
        <Style x:Key="BotaoSuperior" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#344563"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#E8EEF9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MENSAGENS DO CLIENTE -->
        <Style x:Key="MensagemCliente" TargetType="Border">
            <Setter Property="Background" Value="#DCE8FF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="MaxWidth" Value="300"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>

        <!-- MENSAGENS DO CHATBOT -->
        <Style x:Key="MensagemBot" TargetType="Border">
            <Setter Property="Background" Value="#E8EBF1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="MaxWidth" Value="300"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>

        <!-- BOTÃO ENVIAR -->
        <Style x:Key="BotaoEnviar" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#3157A4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#274A90"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ESTRUTURA PRINCIPAL -->
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaMenu" Width="165"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL COMPARTILHADO -->
        <components:MenuLateral x:Name="BarraLateral"
                                Grid.Column="0"/>

        <!-- ÁREA PRINCIPAL -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================================= -->
            <!-- BARRA SUPERIOR -->
            <!-- ================================= -->

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E0E4EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="15,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- BOTÃO HAMBÚRGUER -->
                    <Button x:Name="buttonMenu"
                            Grid.Column="0"
                            Style="{StaticResource BotaoSuperior}"
                            HorizontalAlignment="Left"
                            Click="buttonMenu_Click">

                        <materialDesign:PackIcon Kind="Menu"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#344563"/>
                    </Button>

                    <!-- CONFIGURAÇÕES E NOTIFICAÇÕES -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Style="{StaticResource BotaoSuperior}">
                            <materialDesign:PackIcon Kind="CogOutline"
                                                     Width="23"
                                                     Height="23"
                                                     Foreground="#344563"/>
                        </Button>

                        <Button Style="{StaticResource BotaoSuperior}">
                            <materialDesign:PackIcon Kind="BellOutline"
                                                     Width="23"
                                                     Height="23"
                                                     Foreground="#344563"/>
                        </Button>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- ================================= -->
            <!-- CONTEÚDO DO CHAT -->
            <!-- ================================= -->

            <Border Grid.Row="1"
                    Margin="20,20,20,20"
                    Background="White"
                    BorderBrush="#E0E4EB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="30">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TÍTULO -->
                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,20">

                        <TextBlock Text="Chatbot de Suporte"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#3157A4"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Estamos aqui para ajudar você."
                                   FontSize="13"
                                   Foreground="#8993A5"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- ================================= -->
                    <!-- CONVERSA -->
                    <!-- ================================= -->

                    <ScrollViewer x:Name="ScrollConversa"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel x:Name="PainelMensagens"
                                    Margin="20,0">

                            <!-- MENSAGEM DO CHATBOT -->
                            <Border Style="{StaticResource MensagemBot}"
                                    Margin="0,0,0,30">

                                <TextBlock Text="Olá! Como posso ajudar você hoje?"
                                           FontSize="15"
                                           Foreground="#263B60"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!-- MENSAGEM DO CLIENTE -->
                            <Border Style="{StaticResource MensagemCliente}"
                                    Margin="0,0,0,30">

                                <TextBlock Text="Tenho uma dúvida sobre minha fatura."
                                           FontSize="15"
                                           Foreground="#263B60"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!-- MENSAGEM DO CHATBOT -->
                            <Border Style="{StaticResource MensagemBot}"
                                    Margin="0,0,0,30">

                                <TextBlock Text="Por favor, digite o número da sua fatura para que eu possa verificar."
                                           FontSize="15"
                                           Foreground="#263B60"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!-- MENSAGEM DO CLIENTE -->
                            <Border Style="{StaticResource MensagemCliente}">

                                <TextBlock Text="Minha fatura é 12345."
                                           FontSize="15"
                                           Foreground="#263B60"
                                           TextWrapping="Wrap"/>
                            </Border>

                        </StackPanel>

                    </ScrollViewer>

                    <!-- ================================= -->
                    <!-- CAMPO DE ENVIO -->
                    <!-- ================================= -->

                    <Grid Grid.Row="2"
                          Margin="20,20,20,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- DIGITAR MENSAGEM -->
                        <TextBox x:Name="TxtMensagem"
                                 Grid.Column="0"
                                 Height="42"
                                 FontSize="14"
                                 Padding="12,9"
                                 VerticalContentAlignment="Center"
                                 Background="White"
                                 Foreground="#263B60"
                                 BorderBrush="#D5D9E2"
                                 BorderThickness="1"
                                 MaxLength="500"
                                 ToolTip="Digite sua mensagem"/>

                        <!-- ENVIAR -->
                        <Button x:Name="BtnEnviar"
                                Grid.Column="1"
                                Style="{StaticResource BotaoEnviar}"
                                Margin="10,0,0,0"
                                ToolTip="Enviar mensagem">

                            <materialDesign:PackIcon Kind="Send"
                                                     Width="19"
                                                     Height="19"
                                                     Foreground="White"/>
                        </Button>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>
