<Window x:Class="Loja_Virtual.view.StatusPedido"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:components="clr-namespace:Loja_Virtual.components"
        Title="Status do Pedido"
        Height="750"
        Width="1250"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>

        <Style x:Key="BotaoSuperior" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#344563"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#E8EEF9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CartaoBranco" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E4EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="TextoTitulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#263B60"/>
        </Style>

        <Style x:Key="TextoInfo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#8993A5"/>
        </Style>

        <Style x:Key="CirculoEtapa" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#C8D0DD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LinhaEtapa" TargetType="Border">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#D9E0EA"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,28"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaMenu" Width="165"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:MenuLateral x:Name="BarraLateral"
                                Grid.Column="0"/>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E0E4EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="15,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="buttonMenu"
                            Grid.Column="0"
                            Style="{StaticResource BotaoSuperior}"
                            HorizontalAlignment="Left"
                            Click="buttonMenu_Click">

                        <materialDesign:PackIcon Kind="Menu"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#344563"/>
                    </Button>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Style="{StaticResource BotaoSuperior}">
                            <materialDesign:PackIcon Kind="CogOutline"
                                                     Width="23"
                                                     Height="23"
                                                     Foreground="#344563"/>
                        </Button>

                        <Button Style="{StaticResource BotaoSuperior}">
                            <materialDesign:PackIcon Kind="BellOutline"
                                                     Width="23"
                                                     Height="23"
                                                     Foreground="#344563"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="30,25,30,35">

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Status do Pedido"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#263B60"/>

                        <TextBlock Text="Acompanhe o andamento dos seus pedidos."
                                   FontSize="14"
                                   Foreground="#8993A5"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Border Style="{StaticResource CartaoBranco}"
                            Margin="0,0,0,18">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="Selecione o pedido"
                                           Style="{StaticResource TextoTitulo}"
                                           Margin="0,0,0,8"/>
                                <ComboBox x:Name="ComboPedidos"
                                          Height="38"
                                          SelectionChanged="ComboPedidos_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                <TextBlock Text="Data do pedido"
                                           Style="{StaticResource TextoTitulo}"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtDataPedido"
                                           Text="-"
                                           Style="{StaticResource TextoInfo}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,15,0">
                                <TextBlock Text="Valor total"
                                           Style="{StaticResource TextoTitulo}"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtValorPedido"
                                           Text="R$ 0,00"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#3157A4"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Etapa atual"
                                           Style="{StaticResource TextoTitulo}"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtEtapaAtual"
                                           Text="-"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#263B60"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CartaoBranco}"
                            Margin="0,0,0,18">

                        <StackPanel>
                            <TextBlock Text="Acompanhamento do pedido"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#263B60"
                                       Margin="0,0,0,25"/>

                            <Grid Margin="25,10,25,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                
                                <StackPanel Grid.Column="0">
                                    <Border x:Name="CirculoEtapa1"
                                            Style="{StaticResource CirculoEtapa}"/>
                                    <TextBlock x:Name="TextoEtapa1"
                                               Text="Pedido feito"
                                               Margin="0,12,0,0"
                                               FontSize="13"
                                               TextAlignment="Center"
                                               Foreground="#263B60"/>
                                </StackPanel>

                                <Border x:Name="Linha1"
                                        Grid.Column="1"
                                        Style="{StaticResource LinhaEtapa}"/>

                                
                                <StackPanel Grid.Column="2">
                                    <Border x:Name="CirculoEtapa2"
                                            Style="{StaticResource CirculoEtapa}"/>
                                    <TextBlock x:Name="TextoEtapa2"
                                               Text="Produzindo"
                                               Margin="0,12,0,0"
                                               FontSize="13"
                                               TextAlignment="Center"
                                               Foreground="#263B60"/>
                                </StackPanel>

                                <Border x:Name="Linha2"
                                        Grid.Column="3"
                                        Style="{StaticResource LinhaEtapa}"/>

                               
                                <StackPanel Grid.Column="4">
                                    <Border x:Name="CirculoEtapa3"
                                            Style="{StaticResource CirculoEtapa}"/>
                                    <TextBlock x:Name="TextoEtapa3"
                                               Text="Enviado"
                                               Margin="0,12,0,0"
                                               FontSize="13"
                                               TextAlignment="Center"
                                               Foreground="#263B60"/>
                                </StackPanel>

                                <Border x:Name="Linha3"
                                        Grid.Column="5"
                                        Style="{StaticResource LinhaEtapa}"/>

                                
                                <StackPanel Grid.Column="6">
                                    <Border x:Name="CirculoEtapa4"
                                            Style="{StaticResource CirculoEtapa}"/>
                                    <TextBlock x:Name="TextoEtapa4"
                                               Text="Entregue"
                                               Margin="0,12,0,0"
                                               FontSize="13"
                                               TextAlignment="Center"
                                               Foreground="#263B60"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CartaoBranco}">
                        <StackPanel>
                            <TextBlock Text="Produtos do pedido"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#263B60"
                                       Margin="0,0,0,18"/>

                            <ItemsControl x:Name="ListaItensPedido">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFD"
                                                BorderBrush="#E0E4EB"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14"
                                                Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="55"
                                                        Height="55"
                                                        Background="#EEF2F7"
                                                        CornerRadius="8"
                                                        HorizontalAlignment="Left">
                                                    <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                                             Width="28"
                                                                             Height="28"
                                                                             Foreground="#8C97AA"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NomeProduto}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="#263B60"/>
                                                    <TextBlock Text="{Binding Descricao}"
                                                               FontSize="12"
                                                               Foreground="#8993A5"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center">
                                                    <TextBlock Text="Quantidade"
                                                               FontSize="12"
                                                               Foreground="#8993A5"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Quantidade}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="#263B60"
                                                               HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="Subtotal"
                                                               FontSize="12"
                                                               Foreground="#8993A5"
                                                               HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding Subtotal, StringFormat={}{0:C2}}"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               Foreground="#3157A4"
                                                               HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="TxtSemPedidos"
                                       Text="Nenhum pedido encontrado."
                                       Visibility="Collapsed"
                                       FontSize="14"
                                       Foreground="#8993A5"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>