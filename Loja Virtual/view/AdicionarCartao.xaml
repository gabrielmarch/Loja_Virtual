<Window x:Class="Loja_Virtual.view.AdicionarCartao"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:components="clr-namespace:Loja_Virtual.components"
        Title="Adicionar Cartão"
        Height="750"
        Width="1250"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>

        <!-- BOTÕES DA BARRA SUPERIOR -->
        <Style x:Key="BotaoSuperior" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#344563"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#E8EEF9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO DOS CAMPOS -->
        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#263B60"/>
            <Setter Property="BorderBrush" Value="#D5D9E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ESTILO DOS RÓTULOS -->
        <Style x:Key="LabelCampo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555F70"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <!-- BOTÃO PRINCIPAL -->
        <Style x:Key="BotaoPrincipal" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#3157A4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#274A90"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#203D77"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ESTRUTURA PRINCIPAL -->
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaMenu" Width="165"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL COMPARTILHADO -->
        <components:MenuLateral x:Name="BarraLateral"
                                Grid.Column="0"/>

        <!-- ÁREA PRINCIPAL -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================================= -->
            <!-- BARRA SUPERIOR -->
            <!-- ================================= -->

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E0E4EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="15,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- BOTÃO HAMBÚRGUER -->
                    <Button x:Name="buttonMenu"
                            Grid.Column="0"
                            Style="{StaticResource BotaoSuperior}"
                            HorizontalAlignment="Left"
                            Click="buttonMenu_Click">

                        <materialDesign:PackIcon Kind="Menu"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#344563"/>
                    </Button>

                    <!-- CONFIGURAÇÕES E NOTIFICAÇÕES -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Style="{StaticResource BotaoSuperior}">

                            <materialDesign:PackIcon Kind="CogOutline"
                                                     Width="23"
                                                     Height="23"
                                                     Foreground="#344563"/>
                        </Button>

                        <Button Style="{StaticResource BotaoSuperior}">

                            <materialDesign:PackIcon Kind="BellOutline"
                                                     Width="23"
                                                     Height="23"
                                                     Foreground="#344563"/>
                        </Button>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- ================================= -->
            <!-- CONTEÚDO DA TELA -->
            <!-- ================================= -->

            <Grid Grid.Row="1"
                  Background="#F3F5F9">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid MinHeight="580"
                          Margin="25">

                        <!-- CARTÃO DO FORMULÁRIO -->
                        <Border Width="500"
                                MaxWidth="500"
                                Background="White"
                                BorderBrush="#E0E4EB"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="2"
                                                  Opacity="0.10"/>
                            </Border.Effect>

                            <StackPanel>

                                <!-- ÍCONE -->
                                <Border Width="56"
                                        Height="56"
                                        CornerRadius="12"
                                        Background="#E8EEF9"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,17">

                                    <materialDesign:PackIcon
                                        Kind="CreditCardOutline"
                                        Width="29"
                                        Height="29"
                                        Foreground="#3157A4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>

                                <!-- TÍTULO -->
                                <TextBlock Text="Adicionar Cartão"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#263B60"
                                           TextAlignment="Center"
                                           Margin="0,0,0,7"/>

                                <TextBlock Text="Cadastre um cartão de crédito ou débito."
                                           FontSize="13"
                                           Foreground="#8993A5"
                                           TextAlignment="Center"
                                           Margin="0,0,0,30"/>

                                <!-- NÚMERO DO CARTÃO -->
                                <TextBlock Text="Número do cartão"
                                           Style="{StaticResource LabelCampo}"/>

                                <TextBox x:Name="TxtNumeroCartao"
                                         Style="{StaticResource CampoTexto}"
                                         MaxLength="19"
                                         Margin="0,0,0,18"/>

                                <!-- NOME NO CARTÃO -->
                                <TextBlock Text="Nome no cartão"
                                           Style="{StaticResource LabelCampo}"/>

                                <TextBox x:Name="TxtNomeCartao"
                                         Style="{StaticResource CampoTexto}"
                                         Margin="0,0,0,18"/>

                                <!-- VALIDADE E CVV -->
                                <Grid Margin="0,0,0,28">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- VALIDADE -->
                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="Validade (MM/AA)"
                                                   Style="{StaticResource LabelCampo}"/>

                                        <TextBox x:Name="TxtValidade"
                                                 Style="{StaticResource CampoTexto}"
                                                 MaxLength="5"/>
                                    </StackPanel>

                                    <!-- CVV -->
                                    <StackPanel Grid.Column="2">

                                        <TextBlock Text="CVV"
                                                   Style="{StaticResource LabelCampo}"/>

                                        <PasswordBox x:Name="TxtCvv"
                                                     Height="42"
                                                     FontSize="14"
                                                     Padding="12,8"
                                                     Background="White"
                                                     Foreground="#263B60"
                                                     BorderBrush="#D5D9E2"
                                                     BorderThickness="1"
                                                     VerticalContentAlignment="Center"
                                                     MaxLength="4"/>
                                    </StackPanel>

                                </Grid>

                                <!-- BOTÃO SALVAR -->
                                <Button x:Name="BtnSalvarCartao"
                                        Style="{StaticResource BotaoPrincipal}">

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">

                                        <materialDesign:PackIcon
                                            Kind="ContentSaveOutline"
                                            Width="19"
                                            Height="19"
                                            Margin="0,0,9,0"
                                            VerticalAlignment="Center"/>

                                        <TextBlock Text="Salvar Cartão"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                </Button>

                            </StackPanel>

                        </Border>

                    </Grid>

                </ScrollViewer>

            </Grid>

        </Grid>

    </Grid>

</Window>
