<Window x:Class="Loja_Virtual.view.PainelAdmin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Painel Administrativo - UVVirtual"
        Height="750"
        Width="1250"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- BOTÕES DO MENU -->
        <Style x:Key="BotaoMenuAdmin"
               TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#344563"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#E8EEF9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CARDS DO DASHBOARD -->
        <Style x:Key="CardDashboard"
               TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,15,15"/>
            <Setter Property="BorderBrush" Value="#E0E4EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaMenu"
                              Width="215"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU ADMINISTRATIVO -->
        <Border x:Name="BarraLateral"
                Grid.Column="0"
                Background="White"
                BorderBrush="#E0E4EB"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="75"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="75"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock Text="UVVirtual"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="#3157A4"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="ADMINISTRAÇÃO"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#8993A5"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,18,0,0">

                    <!-- DASHBOARD -->
                    <Button Style="{StaticResource BotaoMenuAdmin}"
                            Background="#E8EEF9"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Kind="ViewDashboardOutline"
                                Width="22"
                                Height="22"
                                Foreground="#3157A4"
                                Margin="0,0,12,0"/>

                            <TextBlock Text="Dashboard"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- CUPONS -->
                    <Button Style="{StaticResource BotaoMenuAdmin}"
                            Click="GerenciarCupons_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Kind="TicketPercentOutline"
                                Width="22"
                                Height="22"
                                Foreground="#3157A4"
                                Margin="0,0,12,0"/>

                            <TextBlock Text="Gerenciar Cupons"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- PRODUTOS -->
                    <Button Style="{StaticResource BotaoMenuAdmin}"
                            Click="GerenciarProdutos_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Kind="PackageVariant"
                                Width="22"
                                Height="22"
                                Foreground="#3157A4"
                                Margin="0,0,12,0"/>

                            <TextBlock Text="Produtos"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>


                    <!-- GERENCIAR PEDIDOS -->
                    <Button Style="{StaticResource BotaoMenuAdmin}"
                            Click="GerenciarPedidos_Click">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                        Kind="ClipboardListOutline"
                                        Width="22"
                                        Height="22"
                                        Foreground="#3157A4"
                                        Margin="0,0,12,0"/>

                            <TextBlock Text="Gerenciar Pedidos"
                                       VerticalAlignment="Center"/>

                        </StackPanel>
                    </Button>


                    <!-- VISUALIZAR LOJA -->
                    <Button Style="{StaticResource BotaoMenuAdmin}"
                            Click="VisualizarLoja_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Kind="StorefrontOutline"
                                Width="22"
                                Height="22"
                                Foreground="#3157A4"
                                Margin="0,0,12,0"/>

                            <TextBlock Text="Visualizar Loja"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- SAIR -->
                <Button Grid.Row="2"
                        Style="{StaticResource BotaoMenuAdmin}"
                        Click="Sair_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Kind="Logout"
                            Width="22"
                            Height="22"
                            Foreground="#C0392B"
                            Margin="0,0,12,0"/>

                        <TextBlock Text="Sair da conta"
                                   Foreground="#C0392B"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ÁREA PRINCIPAL -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E0E4EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Height="40"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="buttonMenu_Click" Margin="0,12,913,12" Grid.ColumnSpan="2">

                        <materialDesign:PackIcon
                            Kind="Menu"
                            Width="25"
                            Height="25"
                            Foreground="#344563" VerticalAlignment="Center"/>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="Painel Administrativo"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#263B60"
                               VerticalAlignment="Top"
                               Margin="62,17,-13,0" Grid.ColumnSpan="2"/>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <materialDesign:PackIcon
                            Kind="ShieldAccountOutline"
                            Width="24"
                            Height="24"
                            Foreground="#3157A4"
                            Margin="0,0,10,0"/>

                        <TextBlock x:Name="NomeAdministrador"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#344563"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTEÚDO DO DASHBOARD -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="30,28,20,30">

                    <TextBlock Text="Visão Geral"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#263B60"/>

                    <TextBlock
                        Text="Acompanhe os dados do Sistema de Loja Virtual."
                        FontSize="14"
                        Foreground="#8993A5"
                        Margin="0,6,0,30"/>

                    <!-- INDICADORES -->
                    <UniformGrid Columns="2"
                                 Margin="0,0,0,15">

                        <!-- PRODUTOS -->
                        <Border Style="{StaticResource CardDashboard}">
                            <StackPanel>
                                <materialDesign:PackIcon
                                    Kind="PackageVariant"
                                    Width="28"
                                    Height="28"
                                    Foreground="#3157A4"/>

                                <TextBlock Text="Produtos cadastrados"
                                           FontSize="14"
                                           Foreground="#8993A5"
                                           Margin="0,12,0,6"/>

                                <TextBlock x:Name="TotalProdutos"
                                           Text="0"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#263B60"/>
                            </StackPanel>
                        </Border>

                        <!-- CLIENTES -->
                        <Border Style="{StaticResource CardDashboard}">
                            <StackPanel>
                                <materialDesign:PackIcon
                                    Kind="AccountGroupOutline"
                                    Width="28"
                                    Height="28"
                                    Foreground="#3157A4"/>

                                <TextBlock Text="Clientes cadastrados"
                                           FontSize="14"
                                           Foreground="#8993A5"
                                           Margin="0,12,0,6"/>

                                <TextBlock x:Name="TotalClientes"
                                           Text="0"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#263B60"/>
                            </StackPanel>
                        </Border>

                        <!-- PEDIDOS -->
                        <Border Style="{StaticResource CardDashboard}">
                            <StackPanel>
                                <materialDesign:PackIcon
                                    Kind="ClipboardListOutline"
                                    Width="28"
                                    Height="28"
                                    Foreground="#3157A4"/>

                                <TextBlock Text="Pedidos registrados"
                                           FontSize="14"
                                           Foreground="#8993A5"
                                           Margin="0,12,0,6"/>

                                <TextBlock x:Name="TotalPedidos"
                                           Text="0"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#263B60"/>
                            </StackPanel>
                        </Border>

                        <!-- CUPONS -->
                        <Border Style="{StaticResource CardDashboard}">
                            <StackPanel>
                                <materialDesign:PackIcon
                                    Kind="TicketPercentOutline"
                                    Width="28"
                                    Height="28"
                                    Foreground="#3157A4"/>

                                <TextBlock Text="Cupons disponíveis"
                                           FontSize="14"
                                           Foreground="#8993A5"
                                           Margin="0,12,0,6"/>

                                <TextBlock x:Name="TotalCupons"
                                           Text="0"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#263B60"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <!-- ACESSO RÁPIDO -->
                    <TextBlock Text="Gerenciamento"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#263B60"
                               Margin="0,10,0,15"/>

                    <Border Background="White"
                            CornerRadius="12"
                            Padding="22"
                            BorderBrush="#E0E4EB"
                            BorderThickness="1">

                        <StackPanel>
                            <TextBlock
                                Text="Gerenciamento de Cupons"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#263B60"/>

                            <TextBlock
                                Text="Cadastre, edite e desative cupons de desconto."
                                Foreground="#8993A5"
                                FontSize="14"
                                Margin="0,8,0,20"/>

                            <Button Content="Gerenciar Cupons"
                                    Width="190"
                                    Height="42"
                                    HorizontalAlignment="Left"
                                    Background="#3157A4"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="GerenciarCupons_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- GERENCIAMENTO DE PEDIDOS -->
                    <Border Background="White"
                            CornerRadius="12"
                            Padding="22"
                            BorderBrush="#E0E4EB"
                            BorderThickness="1"
                            Margin="0,15,0,0">

                        <StackPanel>

                            <TextBlock Text="Gerenciamento de Pedidos"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#263B60"/>

                            <TextBlock
                                        Text="Consulte os pedidos e atualize suas etapas de andamento."
                                        Foreground="#8993A5"
                                        FontSize="14"
                                        Margin="0,8,0,20"/>

                            <Button Content="Gerenciar Pedidos"
                                    Width="190"
                                    Height="42"
                                    HorizontalAlignment="Left"
                                    Background="#3157A4"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="GerenciarPedidos_Click"/>

                        </StackPanel>
                    </Border>


                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
