<Window x:Class="Loja_Virtual.view.Ouvidoria"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:components="clr-namespace:Loja_Virtual.components"
        Title="Ouvidoria"
        Height="750"
        Width="1250"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>

        <!-- BOTÕES DA BARRA SUPERIOR -->
        <Style x:Key="BotaoSuperior" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#344563"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#E8EEF9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CAMPOS DO FORMULÁRIO -->
        <Style x:Key="InputForm" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#263B60"/>
            <Setter Property="BorderBrush" Value="#D5D9E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- BOTÃO PRINCIPAL -->
        <Style x:Key="BotaoPrincipal" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#3157A4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#274A90"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ESTRUTURA PRINCIPAL -->
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaMenu" Width="165"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL COMPARTILHADO -->
        <components:MenuLateral x:Name="BarraLateral"
                                Grid.Column="0"/>

        <!-- ÁREA PRINCIPAL -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E0E4EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="15,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- BOTÃO HAMBÚRGUER -->
                    <Button x:Name="buttonMenu"
                            Grid.Column="0"
                            Style="{StaticResource BotaoSuperior}"
                            HorizontalAlignment="Left"
                            Click="buttonMenu_Click">

                        <materialDesign:PackIcon Kind="Menu"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#344563"/>
                    </Button>

                    <!-- CONFIGURAÇÕES E NOTIFICAÇÕES -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Style="{StaticResource BotaoSuperior}">
                            <materialDesign:PackIcon Kind="CogOutline"
                                                     Width="23"
                                                     Height="23"
                                                     Foreground="#344563"/>
                        </Button>

                        <Button Style="{StaticResource BotaoSuperior}">
                            <materialDesign:PackIcon Kind="BellOutline"
                                                     Width="23"
                                                     Height="23"
                                                     Foreground="#344563"/>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTEÚDO DA OUVIDORIA -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid Margin="25">

                    <Border MaxWidth="650"
                            HorizontalAlignment="Center"
                            Background="White"
                            BorderBrush="#E0E4EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="35">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18"
                                              ShadowDepth="2"
                                              Opacity="0.10"/>
                        </Border.Effect>

                        <StackPanel>

                            <!-- CABEÇALHO -->
                            <Grid Margin="0,0,0,25">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- VOLTAR -->
                                <Button Grid.Column="0"
                                        Style="{StaticResource BotaoSuperior}"
                                        Click="Voltar_Click">

                                    <materialDesign:PackIcon Kind="ArrowLeft"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="#3157A4"/>
                                </Button>

                                <TextBlock Grid.Column="1"
                                           Text="Ouvidoria"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#3157A4"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <!-- ESPAÇO PARA CENTRALIZAR O TÍTULO -->
                                <Border Grid.Column="2"
                                        Width="50"
                                        Background="Transparent"/>

                            </Grid>

                            <!-- FORMULÁRIO -->
                            <Border Background="#F8FAFC"
                                    BorderBrush="#E0E4EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="25"
                                    Margin="0,0,0,20">

                                <StackPanel>

                                    <TextBlock Text="Envie sua Reclamação ou Sugestão"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#263B60"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <TextBlock Text="Utilize o formulário abaixo para nos enviar sua mensagem. Responderemos o mais breve possível."
                                               FontSize="13"
                                               Foreground="#6C7A93"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,0,0,20"/>

                                    <!-- NOME -->
                                    <TextBlock Text="Seu nome"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#555F70"
                                               Margin="0,0,0,6"/>

                                    <TextBox x:Name="TxtNome"
                                             Style="{StaticResource InputForm}"
                                             MaxLength="100"/>

                                    <!-- EMAIL -->
                                    <TextBlock Text="Seu email"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#555F70"
                                               Margin="0,0,0,6"/>

                                    <TextBox x:Name="TxtEmail"
                                             Style="{StaticResource InputForm}"
                                             MaxLength="150"/>

                                    <!-- MENSAGEM -->
                                    <TextBlock Text="Sua mensagem"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#555F70"
                                               Margin="0,0,0,6"/>

                                    <TextBox x:Name="TxtMensagem"
                                             Style="{StaticResource InputForm}"
                                             Height="110"
                                             MaxLength="2000"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"/>

                                    <!-- ENVIAR -->
                                    <Button x:Name="BtnEnviarMensagem"
                                            Style="{StaticResource BotaoPrincipal}"
                                            Margin="0,8,0,0">

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">

                                            <materialDesign:PackIcon Kind="SendOutline"
                                                                     Width="19"
                                                                     Height="19"
                                                                     Margin="0,0,9,0"
                                                                     VerticalAlignment="Center"/>

                                            <TextBlock Text="Enviar Mensagem"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                    </Button>

                                </StackPanel>
                            </Border>

                            <!-- OUTRAS FORMAS DE CONTATO -->
                            <Border Background="#F8FAFC"
                                    BorderBrush="#E0E4EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">

                                <StackPanel>

                                    <TextBlock Text="Outras Formas de Contato"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#263B60"
                                               Margin="0,0,0,14"/>

                                    <!-- TELEFONE -->
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,12">

                                        <materialDesign:PackIcon Kind="Phone"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="#3157A4"
                                                                 Margin="0,0,10,0"
                                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Telefone: (XX) XXXX-XXXX"
                                                   FontSize="13"
                                                   Foreground="#263B60"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- EMAIL -->
                                    <StackPanel Orientation="Horizontal">

                                        <materialDesign:PackIcon Kind="Email"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="#3157A4"
                                                                 Margin="0,0,10,0"
                                                                 VerticalAlignment="Center"/>

                                        <TextBlock Text="Email: ouvidoria@empresa.com"
                                                   FontSize="13"
                                                   Foreground="#263B60"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                        </StackPanel>

                    </Border>

                </Grid>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>
