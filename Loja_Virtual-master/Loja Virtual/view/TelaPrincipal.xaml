<Window x:Class="Loja_Virtual.view.TelaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:components="clr-namespace:Loja_Virtual.components"
        Title="Loja Virtual"
        Height="750"
        Width="1250"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>


        <Style x:Key="BotaoMenu" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#344563"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="8,2"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#E8EEF9"/>

                                <Setter Property="Foreground"
                                        Value="#3157A4"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#DCE5F5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style x:Key="BotaoSuperior" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#344563"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo"
                                        Property="Background"
                                        Value="#E8EEF9"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style x:Key="CartaoProduto" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE2EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaMenu" Width="165"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL COMPARTILHADO -->
        <components:MenuLateral x:Name="BarraLateral"
                        Grid.Column="0"/>


        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E0E4EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="15,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="buttonMenu" Grid.Column="0"
        Style="{StaticResource BotaoSuperior}"
        HorizontalAlignment="Left" Click="buttonMenu_Click">

                        <materialDesign:PackIcon Kind="Menu"
                             Width="24"
                             Height="24"
                             Foreground="#344563"/>
                    </Button>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Style="{StaticResource BotaoSuperior}">
                            <materialDesign:PackIcon Kind="CogOutline"
                             Width="23"
                             Height="23"
                             Foreground="#344563"/>
                        </Button>

                        <Button Style="{StaticResource BotaoSuperior}">
                            <materialDesign:PackIcon Kind="BellOutline"
                             Width="23"
                             Height="23"
                             Foreground="#344563"/>
                        </Button>

                    </StackPanel>

                </Grid>

            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="12,15,12,20">

                    <TextBlock Text="Produtos"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#263B60"
                               Margin="8,5,0,5"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="Confira nossos produtos disponíveis."
                               FontSize="14"
                               Foreground="#8993A5"
                               Margin="8,0,0,15"/>


                    <ItemsControl x:Name="ListaProdutos">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>

                                <UniformGrid Columns="5"/>

                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>


                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Style="{StaticResource CartaoProduto}">

                                    <StackPanel VerticalAlignment="Center">


                                        <Border Height="110"
                                                Background="#F0F3F9"
                                                CornerRadius="6"
                                                Margin="0,0,0,12">

                                            <TextBlock Text="Imagem do produto"
                                                       Foreground="#A0A8B7"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                        </Border>


                                        <TextBlock Text="{Binding Nome}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#263B60"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Margin="0,0,0,8"/>


                                        <TextBlock Text="{Binding Preco, StringFormat='{}{0:C2}', ConverterCulture=pt-BR}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#3157A4"
                                                   HorizontalAlignment="Center"/>

                                        <Button Content="Adicionar ao carrinho"
                                                    Background="#3157A4"
                                                    Foreground="White"
                                                    Padding="10,8"
                                                    Margin="0,12,0,0"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="AdicionarCarrinho_Click"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>
