<Window x:Class="Loja_Virtual.view.Perfil"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:Loja_Virtual.components"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Meu Perfil - Loja Virtual"
        Height="750"
        Width="1250"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9"
        Loaded="Window_Loaded">

    <Window.Resources>

        <Style x:Key="BotaoSuperior"
               TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="#344563"/>
        </Style>

        <Style x:Key="BotaoPrincipal"
               TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Background" Value="#3157A4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaMenu"
                              Width="165"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:MenuLateral x:Name="BarraLateral"
                                Grid.Column="0"/>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E0E4EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="buttonMenu"
                            Grid.Column="0"
                            Style="{StaticResource BotaoSuperior}"
                            Click="buttonMenu_Click">

                        <materialDesign:PackIcon
                            Kind="Menu"
                            Width="25"
                            Height="25"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"/>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="Meu Perfil"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#263B60"
                               VerticalAlignment="Center"
                               Margin="18,0,0,0"/>

                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <Grid Margin="30">

                    <Border Background="White"
                            CornerRadius="15"
                            Padding="35"
                            MaxWidth="650"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="18"
                                ShadowDepth="2"
                                Opacity="0.10"/>
                        </Border.Effect>

                        <StackPanel>

                            <TextBlock Text="Meu Perfil"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#263B60"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,25"/>

                            <Border Width="90"
                                    Height="90"
                                    CornerRadius="45"
                                    Background="#E8EEF9"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,15">

                                <materialDesign:PackIcon
                                    Kind="AccountOutline"
                                    Width="45"
                                    Height="45"
                                    Foreground="#3157A4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock x:Name="NomeUsuario"
                                       Text="Carregando..."
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="#263B60"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,5"/>

                            <TextBlock x:Name="EmailUsuario"
                                       Text=""
                                       FontSize="15"
                                       Foreground="#8993A5"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,25"/>

                            <Border Background="#F8FAFC"
                                    CornerRadius="10"
                                    Padding="18"
                                    Margin="0,0,0,18">

                                <StackPanel>

                                    <TextBlock Text="Informações da conta"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="#263B60"
                                               Margin="0,0,0,15"/>

                                    <TextBlock Text="Tipo de cliente"
                                               FontSize="12"
                                               Foreground="#8993A5"/>

                                    <TextBlock x:Name="TipoClienteTexto"
                                               Text="-"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#263B60"
                                               Margin="0,4,0,12"/>

                                    <TextBlock Text="Telefone"
                                               FontSize="12"
                                               Foreground="#8993A5"/>

                                    <TextBlock x:Name="TelefoneUsuario"
                                               Text="-"
                                               FontSize="15"
                                               Foreground="#263B60"
                                               Margin="0,4,0,12"/>

                                    <TextBlock Text="Endereço"
                                               FontSize="12"
                                               Foreground="#8993A5"/>

                                    <TextBlock x:Name="EnderecoUsuario"
                                               Text="-"
                                               FontSize="15"
                                               Foreground="#263B60"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>

                                </StackPanel>
                            </Border>

                            <Border Background="#F1F3FA"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="0,0,0,22">

                                <StackPanel>

                                    <TextBlock Text="Meus pedidos"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="#263B60"/>

                                    <TextBlock x:Name="QuantidadePedidos"
                                               Text="0"
                                               FontSize="36"
                                               FontWeight="Bold"
                                               Foreground="#3157A4"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="Pedidos realizados"
                                               FontSize="13"
                                               Foreground="#8993A5"/>

                                </StackPanel>
                            </Border>

                            <StackPanel HorizontalAlignment="Center">

                                <Button Content="Voltar para a loja"
                                        Style="{StaticResource BotaoPrincipal}"
                                        Width="200"
                                        Margin="0,0,0,12"
                                        Click="VoltarHome_Click"/>

                                <Button Width="200"
                                        Height="42"
                                        Background="#FDECEC"
                                        Foreground="#C62828"
                                        BorderBrush="#F5C6C6"
                                        BorderThickness="1"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Click="SairConta_Click">

                                    <StackPanel Orientation="Horizontal"
                                                 HorizontalAlignment="Center">

                                        <materialDesign:PackIcon
                                                        Kind="Logout"
                                                        Width="20"
                                                        Height="20"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"/>

                                        <TextBlock Text="Sair da conta"
                                                    VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Button>

                            </StackPanel>


                        </StackPanel>
                    </Border>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
